{
  "name": "axi",
  "version": "0.0.2",
  "description": "axi — coding / research agent. Optional aq train tools via the framework CLI.",
  "type": "module",
  "bin": {
    "axi": "./bin/axi"
  },
  "files": [
    "bin",
    "dist",
    "assets",
    "scripts"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-job-wait.mjs && python3 scripts/build-app-icon.py",
    "prepare": "npm run build",
    "axi": "node dist/cli.js",
    "check:boundaries": "bash scripts/check-module-boundaries.sh",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:public-surface": "bash scripts/check-public-surface.sh",
    "check:corpus": "node scripts/tests/check-corpus.mjs",
    "check": "npm run check:boundaries && npm run check:public-surface && npm run check:budgets && npm run check:corpus",
    "smoke": "node scripts/smoke-binary.mjs",
    "test:unit": "tsx --test 'src/**/*.test.ts'",
    "test": "node scripts/tests/run.mjs",
    "test:training": "node scripts/tests/run.mjs --class training",
    "test:verification": "node scripts/tests/run.mjs --class verification",
    "ready": "npm run build && npm run check && npm run test:unit && npm run smoke"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
