{
  "name": "axi",
  "version": "0.0.2",
  "description": "axi — coding / research agent. Optional aq train tools via the framework CLI.",
  "type": "module",
  "bin": {
    "axi": "./bin/axi"
  },
  "files": [
    "bin",
    "dist",
    "assets",
    "scripts"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-job-wait.mjs && python3 scripts/build-app-icon.py",
    "prepare": "npm run build",
    "axi": "node dist/cli.js",
    "check:boundaries": "bash scripts/check-module-boundaries.sh",
    "test:unit": "tsx --test src/**/*.test.ts",
    "test": "node scripts/tests/run.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
