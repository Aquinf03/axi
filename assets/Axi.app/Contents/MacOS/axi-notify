#!/bin/bash
# Notification helper — runs as Axi.app so Notification Center shows the Aquin icon.
TITLE="${1:-axi}"
BODY="${2:-reply ready}"
# Escape for AppleScript strings
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
/usr/bin/osascript -e "display notification \"$(esc "$BODY")\" with title \"$(esc "$TITLE")\""
